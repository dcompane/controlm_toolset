        "DeleteFileOnDestIfFails" : false,
        "FailJobOnSourceActionFailure" : false,
        "FailJobOnDestActionFailure" : false,
        "FailJobOnSourceCommandFailure" : false,
        "FailJobOnDestCommandFailure" : false,
        "RECURSIVE" : "0",
        "EXCLUDE_WILDCARD" : "0",
        "TRIM" : "1",
        "NULLFLDS" : "0",
        "VERNUM" : "0",
        "CASEIFS" : "0",
