    "DCO_VAS-GenReport" : {
      "Type" : "Job:Command",
      "SubApplication" : "DCO_VAS_REPORTS",
      "Priority" : "High",
      "Host" : "dco-dc01-saasagsand",
      "CreatedBy" : "a-zz23b5",
      "Description" : "Creates a failure and exception report",
      "RunAs" : "saasAgSand",
      "Application" : "DCO",
      "Command" : "ctm reporting report::get \"shared:%%repname.\" csv -o %%repdir./%%filename.-%%thisdate..csv",
      "When" : {
        "WeekDays" : [ "NONE" ],
        "MonthDays" : [ "ALL" ],
        "DaysRelation" : "OR"
      },
      "DCO_VAS_DAILY_JOBS_REPORT" : {
        "Type" : "Resource:Pool",
        "Quantity" : "1"
      },
      "IfBase:Folder:CompletionStatus_0" : {
        "Type" : "If:CompletionStatus",
        "CompletionStatus" : "NOTOK",
        "DoNotify_0" : {
          "Type" : "Action:Notify",
          "Message" : "%%JOBNAME FAILED-PLEASE CONTACT TOOLS TEAM"
        }
      },
      "IfBase:Folder:CompletionStatus_1" : {
        "Type" : "If:CompletionStatus",
        "CompletionStatus" : "OK",
        "Set_0" : {
          "Type" : "Action:Set",
          "Variable" : "\\EMAIL_SUBJECT",
          "Value" : "VAS - Monlthy Prod Job Count"
        }
      },
      "IfBase:Folder:CompletionStatus_2" : {
        "Type" : "If:CompletionStatus",
        "CompletionStatus" : "OK",
        "Set_0" : {
          "Type" : "Action:Set",
          "Variable" : "\\RECIPIENT_LIST",
          "Value" : "john_lee@bmc.com,guilherme_assumpcao@bmc.com,daniel_companeetz@bmc.com,antonio_almeida@bmc.com"
        }
      },
      "IfBase:Folder:CompletionStatus_3" : {
        "Type" : "If:CompletionStatus",
        "CompletionStatus" : "OK",
        "Set_0" : {
          "Type" : "Action:Set",
          "Variable" : "\\REPORT_FILE",
          "Value" : "JOB_COUNT_RPT-%%MONNAM.-%%$YEAR..pdf"
        }
      },
      "eventsToAdd" : {
        "Type" : "AddEvents",
        "Events" : [ {
          "Event" : "DCO_VAS-GenReport-TO-DCO_VAS-ShowRep-%%unique"
        } ]
      }
    },
    "DCO_VAS-ShowRep" : {
      "Type" : "Job:Command",
      "SubApplication" : "DCO_VAS_REPORTS",
      "Host" : "dco-dc01-saasagsand",
      "CreatedBy" : "daniel_companeetz@bmc.com",
      "RunAs" : "saasAgSand",
      "Application" : "DCO",
      "Command" : "head -10 %%repdir/%%filename.-%%thisdate..csv",
      "When" : {
        "WeekDays" : [ "NONE" ],
        "MonthDays" : [ "ALL" ],
        "DaysRelation" : "OR"
      },
      "eventsToWaitFor" : {
        "Type" : "WaitForEvents",
        "Events" : [ {
          "Event" : "DCO_VAS-GenReport-TO-DCO_VAS-ShowRep-%%unique"
        } ]
      },
      "eventsToDelete" : {
        "Type" : "DeleteEvents",
        "Events" : [ {
          "Event" : "DCO_VAS-GenReport-TO-DCO_VAS-ShowRep-%%unique"
        } ]
      }
    }
  },
