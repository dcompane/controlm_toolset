      }, {
        "FTP-HOMEDIR2" : "/home/dcompane1/"
      }, {
        "FTP-CM_VER" : "9.0.00"
      }, {
        "FTP-COMPRESSION11" : "0"
      }, {
        "FTP-COMPRESSION21" : "0"
      }, {
        "FTP-OVERRIDE_WATCH_INTERVAL1" : "0"
      }, {
        "FTP-NEWNAME1" : "$$AFTFILE_ALL$$.bkp"
      }, {
        "FTP-POSTCMD_ON_FAILURE1" : "0"
      }, {
        "FTP-SYNC_DIR_NO_DEL1" : "0"
